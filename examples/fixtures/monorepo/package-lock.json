{
  "name": "tarifa",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "tarifa",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@tarifa/cli": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@tarifa/nucleo": {
      "resolved": "packages/nucleo",
      "link": true
    },
    "packages/cli": {
      "name": "@tarifa/cli",
      "version": "1.2.0",
      "dependencies": {
        "@tarifa/nucleo": "1.2.0"
      },
      "bin": {
        "tarifa": "src/cli.js"
      }
    },
    "packages/nucleo": {
      "name": "@tarifa/nucleo",
      "version": "1.2.0"
    }
  }
}
